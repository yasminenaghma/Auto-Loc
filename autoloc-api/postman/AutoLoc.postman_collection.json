{
  "info": {
    "name": "AutoLoc API",
    "description": "Collection de tests pour l'API AutoLoc",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Agences",
      "item": [
        {
          "name": "Créer une agence",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Code 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.environment.set(\"agenceId\", response.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Agence Centrale\",\n  \"ville\": \"Tunis\",\n  \"adresse\": \"Avenue Habib Bourguiba\",\n  \"telephone\": \"+216 71 123 456\"\n}"
            },
            "url": "{{baseUrl}}/api/agences"
          }
        },
        {
          "name": "Lister les agences",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Code 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Réponse est un tableau\", function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/agences"
          }
        },
        {
          "name": "Consulter une agence",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Code 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/agences/{{agenceId}}"
          }
        },
        {
          "name": "Agence introuvable (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Code 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/agences/99999"
          }
        },
        {
          "name": "Modifier une agence",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Code 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Agence Centrale Modifiée\",\n  \"ville\": \"Tunis\",\n  \"adresse\": \"Avenue Habib Bourguiba, immeuble A\",\n  \"telephone\": \"+216 71 123 457\"\n}"
            },
            "url": "{{baseUrl}}/api/agences/{{agenceId}}"
          }
        },
        {
          "name": "Créer agence invalide (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Code 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Erreurs de validation présentes\", function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.erreurs).to.exist;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"\",\n  \"ville\": \"\"\n}"
            },
            "url": "{{baseUrl}}/api/agences"
          }
        },
        {
          "name": "Supprimer une agence",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Code 204 No Content\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/agences/{{agenceId}}"
          }
        }
      ]
    },
    {
      "name": "Clients",

                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Ben Ali\",\n  \"prenom\": \"Ahmed\",\n  \"email\": \"ahmed.benali@example.com\",\n  \"telephone\": \"+216 98 123 456\",\n  \"numPermis\": \"B123456\",\n  \"dateInscription\": \"2026-11-13\"\n}"
            },
            "url": "{{baseUrl}}/api/clients"
          }
        },
        {
          "name": "Client avec email invalide (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Code 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Test\",\n  \"prenom\": \"User\",\n  \"email\": \"email-invalide\"\n}"
            },
            "url": "{{baseUrl}}/api/clients"
          }
        }
      ]
    },
    {
      "name": "Contrats & Paiements",
      "item": [
        {
          "name": "Créer un contrat",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Code 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.environment.set(\"contratId\", response.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dateSignature\": \"2026-11-13\",\n  \"montantTotal\": 1500.00,\n  \"valide\": true\n}"
            },
            "url": "{{baseUrl}}/api/contrats"
          }
        },
        {
          "name": "Consulter le contrat",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Code 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/contrats/{{contratId}}"
          }
        },
        {
          "name": "Lister tous les paiements",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Code 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/paiements"
          }
        },
        {
          "name": "Créer un paiement (refusé - 405)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Code 405 Method Not Allowed\", function () {",
                  "    pm.response.to.have.status(405);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"montant\": 500.00,\n  \"datePaiement\": \"2026-11-13\",\n  \"modePaiement\": \"CARTE\",\n  \"contratId\": 1\n}"
            },
            "url": "{{baseUrl}}/api/paiements"
          }
        },
        {
          "name": "Contrat avec montant négatif (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Code 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dateSignature\": \"2026-11-13\",\n  \"montantTotal\": -100.00,\n  \"valide\": true\n}"
            },
            "url": "{{baseUrl}}/api/contrats"
          }
        },
        {
          "name": "Supprimer le contrat (cascade)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Code 204 No Content\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/contrats/{{contratId}}"
          }
        }
      ]
    },
    {
      "name": "Cas d'erreur",
      "item": [
